    {
      "name": "Пользователи",
      "item": [
        {
          "name": "Получить список пользователей",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200: до двух клиентов, отсортированных по id\", () => {\n  pm.response.to.have.status(200);\n\n  const users = pm.response.json();\n  pm.expect(users).to.be.an(\"array\");\n  pm.expect(users.length).to.be.within(1, 2);\n\n  users.forEach((user, index) => {\n    pm.expect(user).to.have.all.keys(\"id\", \"login\", \"first_name\", \"last_name\", \"role\");\n    pm.expect(Number.isInteger(user.id) && user.id > 0).to.be.true;\n    pm.expect(user.role).to.equal(\"client\");\n\n    if (index > 0) {\n      pm.expect(user.id).to.be.greaterThan(users[index - 1].id);\n    }\n  });\n\n  pm.collectionVariables.set(\"user_id\", String(users[0].id));\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?role=client",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "client"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Получить пользователя по id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200: получен запрошенный пользователь\", () => {\n  pm.response.to.have.status(200);\n\n  const user = pm.response.json();\n  pm.expect(user).to.have.all.keys(\n    \"id\", \"login\", \"first_name\", \"last_name\", \"role\"\n  );\n  pm.expect(user.id).to.equal(Number(pm.variables.get(\"user_id\")));\n  pm.expect(user.role).to.be.oneOf([\"client\", \"master\", \"admin\"]);\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{user_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{user_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Изменить роль пользователя",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200: роль запрошенного пользователя установлена\", () => {\n  pm.response.to.have.status(200);\n\n  const user = pm.response.json();\n  pm.expect(user).to.have.all.keys(\n    \"id\", \"login\", \"first_name\", \"last_name\", \"role\"\n  );\n  pm.expect(user.id).to.equal(Number(pm.variables.get(\"user_id\")));\n  pm.expect(user.role).to.equal(\"master\");\n});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"role\": \"master\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{user_id}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{user_id}}",
                "role"
              ]
            }
          },
          "response": []
        }
      ]
