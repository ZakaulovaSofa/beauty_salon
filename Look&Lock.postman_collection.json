{
  "info": {
    "_postman_id": "4df8c884-f66e-46ca-bdbc-4d41b8b7515b",
    "name": "Look&Lock",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58885663",
    "_collection_link": "https://go.postman.co/collection/58885663-4df8c884-f66e-46ca-bdbc-4d41b8b7515b?source=collection_link"
  },
  "item": [
    {
      "name": "Аутентификация",
      "item": [
        {
          "name": "Зарегистрировать клиента",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"new_login\", `anna_${pm.variables.replaceIn(\"{{$guid}}\")}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Создан аккаунт — 201\", () => {\n  pm.response.to.have.status(201);\n});\n\npm.test(\"Ответ содержит только access_token в формате JWT\", () => {\n  const body = pm.response.json();\n\n  pm.expect(body).to.have.all.keys(\"access_token\");\n  pm.expect(body.access_token).to.match(\n    /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/,\n  );\n});\n\nif (pm.response.code === 201) {\n  pm.collectionVariables.set(\"registered_login\", pm.variables.get(\"new_login\"));\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Анна\",\n  \"last_name\": \"Иванова\",\n  \"login\": \"{{new_login}}\",\n  \"password\": \"ExamplePassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Войти в систему",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Вход успешен, ответ содержит JWT\", () => {\n  pm.response.to.have.status(200);\n\n  const body = pm.response.json();\n  pm.expect(body).to.have.all.keys(\"access_token\");\n  pm.expect(body.access_token).to.be.a(\"string\").and.match(\n    /^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/\n  );\n\n  pm.collectionVariables.set(\"access_token\", body.access_token);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{registered_login}}\",\n  \"password\": \"ExamplePassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": ""
    },
    {
      "key": "registered_login",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ]
}